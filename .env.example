# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin. Every absolute URL, canonical tag, schema @id, sitemap
# entry and hreflang pair is derived from this. MUST be the real domain.
SITE_ORIGIN=https://www.websitedesigncompany.site

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# 64 random hex chars. Used to sign CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=data/app.db

# ── Payments: PayPal (Stripe is intentionally NOT supported) ────────────────
# The email that receives PayPal invoices / PayPal.me payments
PAYPAL_MERCHANT_EMAIL=
# PayPal.me handle or Pay Link base, e.g. https://www.paypal.com/paypalme/yourhandle
PAYPAL_PAY_LINK=
# Set to the PayPal IPN endpoint to enable automatic payment confirmation.
# Leave blank and an admin confirms settlement from the dashboard instead.
PAYPAL_IPN_VERIFY=

# ── Payments: bank transfer ──────────────────────────────────────────────────
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ROUTING=
BANK_ACCOUNT=
BANK_SWIFT=

# ── Payments: crypto ────────────────────────────────────────────────────────
CRYPTO_NETWORK=USDT (TRC-20)
CRYPTO_WALLET=

# ── Build depth ──────────────────────────────────────────────────────────────
# Blog posts generated per location scope (root + every country + every city)
BUILD_POSTS_PER_LOCATION=3
# Case studies generated per city
BUILD_CASES_PER_LOCATION=1
# Set to 0 to skip service x city pages (much faster builds, smaller site)
BUILD_CITY_PAGES=1

# ── QA ───────────────────────────────────────────────────────────────────────
# 0 = audit every page (slow on network storage). N = stratified sample of N.
QA_SAMPLE=0
